{
  "name": "wallet-vault",
  "version": "0.3.0",
  "description": "Local, self-custody wallet vault for humans and AI agents: EVM + Solana keys, encrypted at rest, spend policies, tamper-evident ledger, MCP server, Hyperliquid agent wallets.",
  "keywords": [
    "wallet",
    "vault",
    "evm",
    "solana",
    "usdc",
    "mcp",
    "agent",
    "hyperliquid",
    "self-custody",
    "viem"
  ],
  "license": "MIT",
  "author": "Kai Kim <kai@deblockxlabs.com> (https://github.com/Joonsense)",
  "homepage": "https://github.com/Joonsense/wallet-vault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joonsense/wallet-vault.git"
  },
  "bugs": {
    "url": "https://github.com/Joonsense/wallet-vault/issues"
  },
  "type": "module",
  "bin": {
    "wv": "./src/cli.mjs"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "README.ko.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/cli.mjs && node --check src/vault.mjs && node --check src/wallets.mjs",
    "prepack": "pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nktkas/hyperliquid": "0.33.3",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "micro-key-producer": "^0.10.2",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  }
}
